# LLM provider (DeepSeek is OpenAI-compatible)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3

# Deep-agent translator (translate/repair). Disable for single-shot prompting.
DEEP_AGENT_ENABLED=true
DEEP_AGENT_MAX_STEPS=60

# MLflow tracing (optional, local, no account required)
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=python-to-rust

# Sandbox
SANDBOX_MODE=docker
SANDBOX_IMAGE=converter-sandbox:latest
SANDBOX_FALLBACK_TO_SUBPROCESS=true
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
TEST_TIMEOUT_S=5
COMPILE_TIMEOUT_S=60
RUN_TIMEOUT_S=120

# Conversion limits
MAX_SOURCE_LINES=500
MAX_ATTEMPTS=3
MAX_GENERATION_ROUNDS=2

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
