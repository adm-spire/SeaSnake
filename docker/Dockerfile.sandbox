# Sandbox image for BOTH Python validation runs and C compile/run.
# Build from the repository root:
#   docker build -f docker/Dockerfile.sandbox -t converter-sandbox:latest .
#
# Alpine keeps the image small (~284 MB versus ~1.3 GB for gcc:13-bookworm).
# The C harness is standard C11 + libm, so musl is a fine target. Runtime
# containers run with no network and a read-only root filesystem, so the
# toolchain and Python must be present in the image.
FROM alpine:3.20

RUN apk add --no-cache gcc musl-dev make python3

ENV HOME=/tmp

WORKDIR /workdir
CMD ["sh"]
